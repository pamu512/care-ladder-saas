# Care Ladder SaaS - deploy image (Galuxium Nexus V2). Copy of upstream
# Dockerfile; this file, never the upstream Dockerfile, is what CI builds
# for the SaaS. CMD runs migrations + demo bootstrap before uvicorn.

FROM python:3.12-slim-bookworm

WORKDIR /app

# Runtime libs for opencv-python (cv2 import); no GUI display needed.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY src ./src
COPY configs ./configs
COPY tests/fixtures ./tests/fixtures
COPY scripts/bootstrap_saas_demo.py ./scripts/bootstrap_saas_demo.py

# Fetch ONNX models (person detection + pose, Apache-2.0) from OpenCV Zoo;
# same sources as scripts/download_models.sh.
ADD https://media.githubusercontent.com/media/opencv/opencv_zoo/main/models/person_detection_mediapipe/person_detection_mediapipe_2023mar.onnx /app/models/person_detection_mediapipe_2023mar.onnx
ADD https://media.githubusercontent.com/media/opencv/opencv_zoo/main/models/pose_estimation_mediapipe/pose_estimation_mediapipe_2023mar.onnx /app/models/pose_estimation_mediapipe_2023mar.onnx

# Editable install keeps package paths under /app/src so api.app resolves
# configs via Path(__file__).parents[3] / "configs".
RUN pip install --no-cache-dir -e .

ENV HOST=0.0.0.0 \
    PORT=8000 \
    PYTHONUNBUFFERED=1

EXPOSE 8000

# Schema create_all (idempotent; this fork has no alembic migrations),
# then demo tenant bootstrap (idempotent), then the API.
# Render health probe: GET /demo/context.
CMD ["sh", "-c", "python scripts/bootstrap_saas_demo.py && uvicorn care_ladder.api.app:app --host 0.0.0.0 --port ${PORT:-8000}"]
