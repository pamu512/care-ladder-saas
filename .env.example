# Care Ladder SaaS - environment template (copy to .env, never commit the copy).
# Local zero-config: CARE_LADDER_AUTH unset/off and DATABASE_URL unset.
# DATABASE_URL set without AUTH=off turns auth on (hosted fail-closed).

# Postgres in prod (Render injects this); sqlite fallback locally.
DATABASE_URL=sqlite:///./saas-demo.db

# Required when CARE_LADDER_AUTH=on. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me

# demo in hackathon deploys; set to prod only if you know why
CARE_LADDER_ENV=demo

# on = sessions required on /demo/* and /incidents* (401 otherwise).
# Unset + DATABASE_URL set => on. Explicit off wins even with DATABASE_URL.
CARE_LADDER_AUTH=off

# Public https origin for Stripe success/cancel URLs. Optional: checkout prefers
# X-Forwarded-Proto/Host (Render). Fallback: PUBLIC_BASE_URL, then Render's
# RENDER_EXTERNAL_URL (injected automatically on Render).
PUBLIC_BASE_URL=

# Stripe test-mode price IDs (Stripe dashboard); empty = billing buttons disabled
STRIPE_PRICE_HOME=
STRIPE_PRICE_FACILITY=
STRIPE_PRICE_FACILITY_GROWTH=

# Stripe webhook signing secret for https://<host>/billing/webhook. Unset secret
# rejects unsigned POSTs unless CARE_LADDER_ALLOW_UNSIGNED_WEBHOOKS=1 (local only).
# CARE_LADDER_ENV=demo does not by itself accept unsigned webhooks.
STRIPE_WEBHOOK_SECRET=
CARE_LADDER_ALLOW_UNSIGNED_WEBHOOKS=

# Facility supervisor row: real Slack incoming webhook; empty = stub (logged only)
SLACK_WEBHOOK_URL=

# P1 family Telegram runtime. Without token+chat_id the adapter stays stub.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# poll = long-poll getUpdates (demo default). hook = POST /telegram/webhook
TELEGRAM_MODE=poll
# Required when TELEGRAM_MODE=hook (e.g. https://<host>/telegram/webhook)
TELEGRAM_HOOK_URL=
# Required when TELEGRAM_MODE=hook and TELEGRAM_BOT_TOKEN is set. Passed to
# setWebhook(secret_token=...) and checked on POST /telegram/webhook via
# X-Telegram-Bot-Api-Secret-Token (fail closed on mismatch / unset).
TELEGRAM_WEBHOOK_SECRET=
# Optional override of configs/demo_family.yaml
FAMILY_PLAN_PATH=
# Optional: Vertex LLM reply classification (falls back to keywords without these)
VERTEX_PROJECT=
VERTEX_LOCATION=global
VERTEX_REPLY_MODEL=gemini-2.0-flash
